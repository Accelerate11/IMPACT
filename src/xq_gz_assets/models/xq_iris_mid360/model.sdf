<?xml version="1.0"?>
<sdf version="1.10">
  <model name="xq_iris_mid360" canonical_link="xq_base_link">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!--
      This is a deterministic benchmark carrier, not an ArduPilot flight-dynamics
      model.  Gravity is disabled and Gazebo's VelocityControl system accepts a
      6-DoF Twist on /model/<instance>/cmd_vel.  That keeps SLAM and planning tests
      independent from any existing SITL project while retaining dynamic poses.
    -->
    <link name="xq_base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>1.40</mass>
        <inertia>
          <ixx>0.030</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.030</iyy>
          <iyz>0.0</iyz>
          <izz>0.055</izz>
        </inertia>
      </inertial>

      <collision name="xq_body_collision">
        <geometry>
          <box>
            <size>0.30 0.22 0.10</size>
          </box>
        </geometry>
      </collision>
      <visual name="xq_body_visual">
        <geometry>
          <box>
            <size>0.30 0.22 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.035 0.045 0.060 1</ambient>
          <diffuse>0.055 0.075 0.100 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>

      <collision name="xq_arm_ne_sw_collision">
        <pose>0 0 0.015 0 0 0.78539816339</pose>
        <geometry>
          <box>
            <size>0.66 0.035 0.028</size>
          </box>
        </geometry>
      </collision>
      <visual name="xq_arm_ne_sw_visual">
        <pose>0 0 0.015 0 0 0.78539816339</pose>
        <geometry>
          <box>
            <size>0.66 0.035 0.028</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.13 0.15 1</ambient>
          <diffuse>0.18 0.20 0.23 1</diffuse>
        </material>
      </visual>

      <collision name="xq_arm_nw_se_collision">
        <pose>0 0 0.015 0 0 -0.78539816339</pose>
        <geometry>
          <box>
            <size>0.66 0.035 0.028</size>
          </box>
        </geometry>
      </collision>
      <visual name="xq_arm_nw_se_visual">
        <pose>0 0 0.015 0 0 -0.78539816339</pose>
        <geometry>
          <box>
            <size>0.66 0.035 0.028</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.13 0.15 1</ambient>
          <diffuse>0.18 0.20 0.23 1</diffuse>
        </material>
      </visual>

      <visual name="xq_rotor_front_left_visual">
        <pose>0.235 0.235 0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <transparency>0.35</transparency>
        <material>
          <ambient>0.08 0.55 0.78 1</ambient>
          <diffuse>0.08 0.55 0.78 1</diffuse>
        </material>
      </visual>
      <visual name="xq_rotor_front_right_visual">
        <pose>0.235 -0.235 0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <transparency>0.35</transparency>
        <material>
          <ambient>0.08 0.55 0.78 1</ambient>
          <diffuse>0.08 0.55 0.78 1</diffuse>
        </material>
      </visual>
      <visual name="xq_rotor_rear_left_visual">
        <pose>-0.235 0.235 0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <transparency>0.35</transparency>
        <material>
          <ambient>0.78 0.29 0.10 1</ambient>
          <diffuse>0.78 0.29 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="xq_rotor_rear_right_visual">
        <pose>-0.235 -0.235 0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <transparency>0.35</transparency>
        <material>
          <ambient>0.78 0.29 0.10 1</ambient>
          <diffuse>0.78 0.29 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="xq_mid360_link">
      <pose relative_to="xq_base_link">0.04 0 0.135 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.00045</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00045</iyy>
          <iyz>0.0</iyz>
          <izz>0.00055</izz>
        </inertia>
      </inertial>
      <collision name="xq_mid360_collision">
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="xq_mid360_visual">
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.065</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.025 1</ambient>
          <diffuse>0.035 0.035 0.045 1</diffuse>
          <specular>0.55 0.55 0.55 1</specular>
        </material>
      </visual>

      <!-- MID-360-like aggregate raster: 720 x 32 x 10 Hz ~= 230 kpoints/s. -->
      <sensor name="xq_mid360_lidar" type="gpu_lidar">
        <!-- Gazebo publishes LaserScan here and PointCloudPacked on /points. -->
        <topic>/xq/lidar</topic>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.12217304764</min_angle>
              <max_angle>0.90757121104</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>40.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.015</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <joint name="xq_mid360_joint" type="fixed">
      <parent>xq_base_link</parent>
      <child>xq_mid360_link</child>
    </joint>

    <link name="xq_imu_link">
      <pose relative_to="xq_base_link">0 0 0.015 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.020</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0.0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="xq_imu_sensor" type="imu">
        <topic>/xq/imu</topic>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00020</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00020</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00020</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0020</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0020</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0020</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <joint name="xq_imu_joint" type="fixed">
      <parent>xq_base_link</parent>
      <child>xq_imu_link</child>
    </joint>

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_frame>xq_world</odom_frame>
      <robot_base_frame>xq_base_link</robot_base_frame>
    </plugin>
  </model>
</sdf>
