<?xml version="1.0"?>
<sdf version="1.9">
  <world name="xq_p4_external_nav">
    <gravity>0 0 -9.80665</gravity>
    <physics name="xq_p4_1khz" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.72 0.74 0.78</ambient>
      <background>0.18 0.20 0.24</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="xq_p4_sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Clear 6 x 6 m flight box, with asymmetric geometry outside it. -->
    <model name="xq_p4_room">
      <static>true</static>
      <link name="room_link">
        <collision name="floor_c"><pose>0 0 -0.05 0 0 0</pose><geometry><box><size>18 18 0.1</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 -0.05 0 0 0</pose><geometry><box><size>18 18 0.1</size></box></geometry><material><ambient>0.34 0.36 0.39 1</ambient><diffuse>0.44 0.46 0.49 1</diffuse></material></visual>
        <collision name="ceiling_c"><pose>0 0 4.0 0 0 0</pose><geometry><box><size>18 18 0.1</size></box></geometry></collision>
        <visual name="ceiling_v"><pose>0 0 4.0 0 0 0</pose><geometry><box><size>18 18 0.1</size></box></geometry><material><ambient>0.72 0.72 0.70 1</ambient><diffuse>0.82 0.82 0.80 1</diffuse></material></visual>
        <collision name="wall_w_c"><pose>-9 0 2 0 0 0</pose><geometry><box><size>0.2 18 4</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-9 0 2 0 0 0</pose><geometry><box><size>0.2 18 4</size></box></geometry><material><ambient>0.58 0.63 0.68 1</ambient><diffuse>0.68 0.73 0.78 1</diffuse></material></visual>
        <collision name="wall_e_c"><pose>9 0 2 0 0 0</pose><geometry><box><size>0.2 18 4</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>9 0 2 0 0 0</pose><geometry><box><size>0.2 18 4</size></box></geometry><material><ambient>0.58 0.63 0.68 1</ambient><diffuse>0.68 0.73 0.78 1</diffuse></material></visual>
        <collision name="wall_s_c"><pose>0 -9 2 0 0 0</pose><geometry><box><size>18 0.2 4</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>0 -9 2 0 0 0</pose><geometry><box><size>18 0.2 4</size></box></geometry><material><ambient>0.61 0.57 0.46 1</ambient><diffuse>0.72 0.68 0.56 1</diffuse></material></visual>
        <collision name="wall_n_c"><pose>0 9 2 0 0 0</pose><geometry><box><size>18 0.2 4</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>0 9 2 0 0 0</pose><geometry><box><size>18 0.2 4</size></box></geometry><material><ambient>0.50 0.59 0.52 1</ambient><diffuse>0.60 0.70 0.62 1</diffuse></material></visual>

        <collision name="column_nw_c"><pose>-5 5 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3</length></cylinder></geometry></collision>
        <visual name="column_nw_v"><pose>-5 5 1.5 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>3</length></cylinder></geometry><material><ambient>0.75 0.35 0.10 1</ambient><diffuse>0.85 0.45 0.14 1</diffuse></material></visual>
        <collision name="column_se_c"><pose>5 -5 1.5 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>3</length></cylinder></geometry></collision>
        <visual name="column_se_v"><pose>5 -5 1.5 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>3</length></cylinder></geometry><material><ambient>0.15 0.48 0.68 1</ambient><diffuse>0.20 0.58 0.78 1</diffuse></material></visual>
        <collision name="cabinet_ne_c"><pose>5.8 4.4 1.0 0 0 0.25</pose><geometry><box><size>1.2 2.0 2.0</size></box></geometry></collision>
        <visual name="cabinet_ne_v"><pose>5.8 4.4 1.0 0 0 0.25</pose><geometry><box><size>1.2 2.0 2.0</size></box></geometry><material><ambient>0.47 0.28 0.52 1</ambient><diffuse>0.57 0.36 0.62 1</diffuse></material></visual>
        <collision name="crate_sw_c"><pose>-5.6 -4.7 0.6 0.1 0.05 -0.35</pose><geometry><box><size>1.1 1.4 1.2</size></box></geometry></collision>
        <visual name="crate_sw_v"><pose>-5.6 -4.7 0.6 0.1 0.05 -0.35</pose><geometry><box><size>1.1 1.4 1.2</size></box></geometry><material><ambient>0.48 0.23 0.08 1</ambient><diffuse>0.62 0.31 0.11 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <name>xq_p4_uav1</name>
      <uri>model://xq_iris_mid360_ardupilot</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>
  </world>
</sdf>
