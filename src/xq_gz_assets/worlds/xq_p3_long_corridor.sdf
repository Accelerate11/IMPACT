<?xml version="1.0"?>
<sdf version="1.10">
  <world name="xq_p3_long_corridor">
    <gravity>0 0 -9.80665</gravity>
    <physics name="xq_p3_400hz_physics" type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.70 0.72 0.76</ambient>
      <background>0.16 0.18 0.22</background>
    </scene>
    <light name="xq_corridor_sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.86 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="xq_corridor_shell">
      <static>true</static>
      <link name="xq_corridor_shell_link">
        <collision name="floor_c"><pose>0 0 -0.06 0 0 0</pose><geometry><box><size>30 5 0.12</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 -0.06 0 0 0</pose><geometry><box><size>30 5 0.12</size></box></geometry><material><diffuse>0.42 0.44 0.48 1</diffuse></material></visual>
        <collision name="ceiling_c"><pose>0 0 3.15 0 0 0</pose><geometry><box><size>30 5 0.10</size></box></geometry></collision>
        <visual name="ceiling_v"><pose>0 0 3.15 0 0 0</pose><geometry><box><size>30 5 0.10</size></box></geometry><material><diffuse>0.76 0.77 0.79 1</diffuse></material></visual>
        <collision name="wall_n_c"><pose>0 2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>0 2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry><material><diffuse>0.64 0.68 0.73 1</diffuse></material></visual>
        <collision name="wall_s_c"><pose>0 -2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>0 -2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry><material><diffuse>0.58 0.63 0.69 1</diffuse></material></visual>
        <collision name="end_w_c"><pose>-15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry></collision>
        <visual name="end_w_v"><pose>-15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry><material><diffuse>0.50 0.58 0.65 1</diffuse></material></visual>
        <collision name="end_e_c"><pose>15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry></collision>
        <visual name="end_e_v"><pose>15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry><material><diffuse>0.63 0.53 0.42 1</diffuse></material></visual>

        <!-- Asymmetric recess markers prevent a perfectly featureless corridor. -->
        <collision name="pier_01_c"><pose>-9.0 2.18 1.0 0 0 0</pose><geometry><box><size>0.45 0.55 2.0</size></box></geometry></collision>
        <visual name="pier_01_v"><pose>-9.0 2.18 1.0 0 0 0</pose><geometry><box><size>0.45 0.55 2.0</size></box></geometry><material><diffuse>0.72 0.31 0.18 1</diffuse></material></visual>
        <collision name="pier_02_c"><pose>-4.0 -2.12 0.75 0 0 0</pose><geometry><box><size>0.60 0.65 1.5</size></box></geometry></collision>
        <visual name="pier_02_v"><pose>-4.0 -2.12 0.75 0 0 0</pose><geometry><box><size>0.60 0.65 1.5</size></box></geometry><material><diffuse>0.21 0.52 0.64 1</diffuse></material></visual>
        <collision name="pier_03_c"><pose>1.5 2.10 1.20 0 0 0</pose><geometry><box><size>0.35 0.70 2.4</size></box></geometry></collision>
        <visual name="pier_03_v"><pose>1.5 2.10 1.20 0 0 0</pose><geometry><box><size>0.35 0.70 2.4</size></box></geometry><material><diffuse>0.29 0.62 0.35 1</diffuse></material></visual>
        <collision name="pier_04_c"><pose>7.0 -2.15 0.90 0 0 0</pose><geometry><box><size>0.50 0.60 1.8</size></box></geometry></collision>
        <visual name="pier_04_v"><pose>7.0 -2.15 0.90 0 0 0</pose><geometry><box><size>0.50 0.60 1.8</size></box></geometry><material><diffuse>0.62 0.45 0.18 1</diffuse></material></visual>
        <collision name="crate_c"><pose>11.0 1.65 0.45 0 0 0.35</pose><geometry><box><size>1.0 0.8 0.9</size></box></geometry></collision>
        <visual name="crate_v"><pose>11.0 1.65 0.45 0 0 0.35</pose><geometry><box><size>1.0 0.8 0.9</size></box></geometry><material><diffuse>0.52 0.27 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <name>xq_agent_01</name>
      <uri>model://xq_iris_mid360</uri>
      <pose>-12 0 1.2 0 0 0</pose>
    </include>
  </world>
</sdf>
