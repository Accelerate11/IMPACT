<?xml version="1.0"?>
<sdf version="1.10">
  <world name="xq_indoor_office">
    <gravity>0 0 -9.80665</gravity>
    <physics name="xq_400hz_physics" type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.72 0.74 0.78</ambient>
      <background>0.18 0.20 0.24</background>
      <shadows>true</shadows>
    </scene>

    <light name="xq_ceiling_light" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.92 0.92 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.8</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.15 -0.92</direction>
    </light>

    <!--
      The complete office shell is defined inline.  This world does not include,
      overwrite, or resolve any external map.
    -->
    <model name="xq_office_shell">
      <static>true</static>
      <link name="xq_shell_link">
        <collision name="xq_floor_collision">
          <pose>0 0 -0.06 0 0 0</pose>
          <geometry><box><size>20 16 0.12</size></box></geometry>
        </collision>
        <visual name="xq_floor_visual">
          <pose>0 0 -0.06 0 0 0</pose>
          <geometry><box><size>20 16 0.12</size></box></geometry>
          <material>
            <ambient>0.38 0.40 0.43 1</ambient>
            <diffuse>0.48 0.50 0.53 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>

        <collision name="xq_ceiling_collision">
          <pose>0 0 3.15 0 0 0</pose>
          <geometry><box><size>20 16 0.10</size></box></geometry>
        </collision>
        <visual name="xq_ceiling_visual">
          <pose>0 0 3.15 0 0 0</pose>
          <geometry><box><size>20 16 0.10</size></box></geometry>
          <material>
            <ambient>0.72 0.73 0.74 1</ambient>
            <diffuse>0.82 0.83 0.84 1</diffuse>
          </material>
        </visual>

        <collision name="xq_wall_west_collision">
          <pose>-10 0 1.55 0 0 0</pose>
          <geometry><box><size>0.20 16 3.10</size></box></geometry>
        </collision>
        <visual name="xq_wall_west_visual">
          <pose>-10 0 1.55 0 0 0</pose>
          <geometry><box><size>0.20 16 3.10</size></box></geometry>
          <material><ambient>0.62 0.65 0.69 1</ambient><diffuse>0.72 0.75 0.79 1</diffuse></material>
        </visual>
        <collision name="xq_wall_east_collision">
          <pose>10 0 1.55 0 0 0</pose>
          <geometry><box><size>0.20 16 3.10</size></box></geometry>
        </collision>
        <visual name="xq_wall_east_visual">
          <pose>10 0 1.55 0 0 0</pose>
          <geometry><box><size>0.20 16 3.10</size></box></geometry>
          <material><ambient>0.62 0.65 0.69 1</ambient><diffuse>0.72 0.75 0.79 1</diffuse></material>
        </visual>
        <collision name="xq_wall_south_collision">
          <pose>0 -8 1.55 0 0 0</pose>
          <geometry><box><size>20 0.20 3.10</size></box></geometry>
        </collision>
        <visual name="xq_wall_south_visual">
          <pose>0 -8 1.55 0 0 0</pose>
          <geometry><box><size>20 0.20 3.10</size></box></geometry>
          <material><ambient>0.62 0.65 0.69 1</ambient><diffuse>0.72 0.75 0.79 1</diffuse></material>
        </visual>
        <collision name="xq_wall_north_collision">
          <pose>0 8 1.55 0 0 0</pose>
          <geometry><box><size>20 0.20 3.10</size></box></geometry>
        </collision>
        <visual name="xq_wall_north_visual">
          <pose>0 8 1.55 0 0 0</pose>
          <geometry><box><size>20 0.20 3.10</size></box></geometry>
          <material><ambient>0.62 0.65 0.69 1</ambient><diffuse>0.72 0.75 0.79 1</diffuse></material>
        </visual>

        <!-- Closed central service core produces a repeatable loop trajectory. -->
        <collision name="xq_core_west_collision">
          <pose>-3.0 0 1.55 0 0 0</pose>
          <geometry><box><size>0.18 4.4 3.10</size></box></geometry>
        </collision>
        <visual name="xq_core_west_visual">
          <pose>-3.0 0 1.55 0 0 0</pose>
          <geometry><box><size>0.18 4.4 3.10</size></box></geometry>
          <material><ambient>0.27 0.36 0.43 1</ambient><diffuse>0.34 0.46 0.55 1</diffuse></material>
        </visual>
        <collision name="xq_core_east_collision">
          <pose>3.0 0 1.55 0 0 0</pose>
          <geometry><box><size>0.18 4.4 3.10</size></box></geometry>
        </collision>
        <visual name="xq_core_east_visual">
          <pose>3.0 0 1.55 0 0 0</pose>
          <geometry><box><size>0.18 4.4 3.10</size></box></geometry>
          <material><ambient>0.27 0.36 0.43 1</ambient><diffuse>0.34 0.46 0.55 1</diffuse></material>
        </visual>
        <collision name="xq_core_south_collision">
          <pose>0 -2.2 1.55 0 0 0</pose>
          <geometry><box><size>6.18 0.18 3.10</size></box></geometry>
        </collision>
        <visual name="xq_core_south_visual">
          <pose>0 -2.2 1.55 0 0 0</pose>
          <geometry><box><size>6.18 0.18 3.10</size></box></geometry>
          <material><ambient>0.27 0.36 0.43 1</ambient><diffuse>0.34 0.46 0.55 1</diffuse></material>
        </visual>
        <collision name="xq_core_north_collision">
          <pose>0 2.2 1.55 0 0 0</pose>
          <geometry><box><size>6.18 0.18 3.10</size></box></geometry>
        </collision>
        <visual name="xq_core_north_visual">
          <pose>0 2.2 1.55 0 0 0</pose>
          <geometry><box><size>6.18 0.18 3.10</size></box></geometry>
          <material><ambient>0.27 0.36 0.43 1</ambient><diffuse>0.34 0.46 0.55 1</diffuse></material>
        </visual>

        <!-- Offset partitions add door gaps, corners, and non-symmetric returns. -->
        <collision name="xq_partition_nw_collision">
          <pose>-6.7 3.9 1.30 0 0 0</pose>
          <geometry><box><size>4.8 0.16 2.60</size></box></geometry>
        </collision>
        <visual name="xq_partition_nw_visual">
          <pose>-6.7 3.9 1.30 0 0 0</pose>
          <geometry><box><size>4.8 0.16 2.60</size></box></geometry>
          <material><ambient>0.61 0.54 0.39 1</ambient><diffuse>0.72 0.65 0.49 1</diffuse></material>
        </visual>
        <collision name="xq_partition_ne_collision">
          <pose>6.8 4.7 1.30 0 0 0</pose>
          <geometry><box><size>0.16 5.2 2.60</size></box></geometry>
        </collision>
        <visual name="xq_partition_ne_visual">
          <pose>6.8 4.7 1.30 0 0 0</pose>
          <geometry><box><size>0.16 5.2 2.60</size></box></geometry>
          <material><ambient>0.48 0.57 0.43 1</ambient><diffuse>0.58 0.68 0.53 1</diffuse></material>
        </visual>
        <collision name="xq_partition_sw_collision">
          <pose>-5.8 -4.8 1.30 0 0 0</pose>
          <geometry><box><size>0.16 3.8 2.60</size></box></geometry>
        </collision>
        <visual name="xq_partition_sw_visual">
          <pose>-5.8 -4.8 1.30 0 0 0</pose>
          <geometry><box><size>0.16 3.8 2.60</size></box></geometry>
          <material><ambient>0.50 0.42 0.52 1</ambient><diffuse>0.61 0.52 0.63 1</diffuse></material>
        </visual>
        <collision name="xq_partition_se_collision">
          <pose>6.6 -4.5 1.30 0 0 0</pose>
          <geometry><box><size>5.0 0.16 2.60</size></box></geometry>
        </collision>
        <visual name="xq_partition_se_visual">
          <pose>6.6 -4.5 1.30 0 0 0</pose>
          <geometry><box><size>5.0 0.16 2.60</size></box></geometry>
          <material><ambient>0.47 0.49 0.60 1</ambient><diffuse>0.57 0.59 0.71 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="xq_office_features">
      <static>true</static>
      <link name="xq_features_link">
        <collision name="xq_column_01_collision">
          <pose>-7.6 1.3 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.24</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="xq_column_01_visual">
          <pose>-7.6 1.3 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.24</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.72 0.43 0.12 1</ambient><diffuse>0.87 0.54 0.16 1</diffuse></material>
        </visual>
        <collision name="xq_column_02_collision">
          <pose>7.4 -0.8 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="xq_column_02_visual">
          <pose>7.4 -0.8 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.18 0.49 0.58 1</ambient><diffuse>0.22 0.62 0.72 1</diffuse></material>
        </visual>
        <collision name="xq_column_03_collision">
          <pose>-4.6 6.3 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="xq_column_03_visual">
          <pose>-4.6 6.3 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.30 0.58 0.29 1</ambient><diffuse>0.38 0.71 0.36 1</diffuse></material>
        </visual>

        <collision name="xq_desk_01_collision">
          <pose>-7.8 6.2 0.45 0 0 0.25</pose>
          <geometry><box><size>2.1 0.8 0.9</size></box></geometry>
        </collision>
        <visual name="xq_desk_01_visual">
          <pose>-7.8 6.2 0.45 0 0 0.25</pose>
          <geometry><box><size>2.1 0.8 0.9</size></box></geometry>
          <material><ambient>0.38 0.20 0.09 1</ambient><diffuse>0.51 0.29 0.12 1</diffuse></material>
        </visual>
        <collision name="xq_desk_02_collision">
          <pose>7.8 6.6 0.55 0 0 -0.35</pose>
          <geometry><box><size>1.7 0.9 1.1</size></box></geometry>
        </collision>
        <visual name="xq_desk_02_visual">
          <pose>7.8 6.6 0.55 0 0 -0.35</pose>
          <geometry><box><size>1.7 0.9 1.1</size></box></geometry>
          <material><ambient>0.23 0.28 0.36 1</ambient><diffuse>0.31 0.38 0.49 1</diffuse></material>
        </visual>
        <collision name="xq_cabinet_01_collision">
          <pose>-8.8 -1.7 1.0 0 0 0</pose>
          <geometry><box><size>0.7 1.3 2.0</size></box></geometry>
        </collision>
        <visual name="xq_cabinet_01_visual">
          <pose>-8.8 -1.7 1.0 0 0 0</pose>
          <geometry><box><size>0.7 1.3 2.0</size></box></geometry>
          <material><ambient>0.48 0.50 0.52 1</ambient><diffuse>0.58 0.60 0.62 1</diffuse></material>
        </visual>
        <collision name="xq_cabinet_02_collision">
          <pose>8.9 2.5 0.75 0 0 0</pose>
          <geometry><box><size>0.6 1.8 1.5</size></box></geometry>
        </collision>
        <visual name="xq_cabinet_02_visual">
          <pose>8.9 2.5 0.75 0 0 0</pose>
          <geometry><box><size>0.6 1.8 1.5</size></box></geometry>
          <material><ambient>0.56 0.50 0.22 1</ambient><diffuse>0.67 0.61 0.27 1</diffuse></material>
        </visual>
        <collision name="xq_crate_01_collision">
          <pose>4.8 -6.4 0.40 0.12 0.04 0.55</pose>
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="xq_crate_01_visual">
          <pose>4.8 -6.4 0.40 0.12 0.04 0.55</pose>
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.54 0.27 0.10 1</ambient><diffuse>0.68 0.35 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      A deterministic moving obstacle traverses the south corridor.  It is
      owned by this world and never publishes to, or resolves assets from, any
      pre-existing Gazebo project.  This exercises time-decaying occupancy;
      it is not by itself proof of the official obstacle-to-replan latency.
    -->
    <model name="xq_dynamic_obstacle">
      <pose>0 -5.8 0.55 0 0 0</pose>
      <link name="xq_dynamic_obstacle_link">
        <gravity>false</gravity>
        <inertial>
          <mass>12.0</mass>
          <inertia>
            <ixx>1.30</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.30</iyy><iyz>0</iyz><izz>0.80</izz>
          </inertia>
        </inertial>
        <collision name="xq_dynamic_obstacle_collision">
          <geometry><box><size>0.70 0.70 1.10</size></box></geometry>
        </collision>
        <visual name="xq_dynamic_obstacle_visual">
          <geometry><box><size>0.70 0.70 1.10</size></box></geometry>
          <material><ambient>0.68 0.08 0.06 1</ambient><diffuse>0.86 0.11 0.08 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>-0.10 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>
    </model>

    <include>
      <name>xq_agent_01</name>
      <uri>model://xq_iris_mid360</uri>
      <pose>-7.0 -5.0 1.2 0 0 0</pose>
    </include>
  </world>
</sdf>
