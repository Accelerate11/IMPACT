<?xml version="1.0"?>
<sdf version="1.10">
  <world name="xq_p11_integrity_exploration">
    <gravity>0 0 -9.80665</gravity>
    <physics name="xq_p11_400hz_physics" type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.70 0.72 0.76</ambient><background>0.16 0.18 0.22</background></scene>
    <light name="xq_p11_sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.86 1</diffuse><direction>-0.3 0.2 -1</direction></light>

    <!-- Dedicated open-top P11 world; all walls remain visible in Gazebo. -->
    <model name="xq_p11_exploration_shell">
      <static>true</static>
      <link name="shell_link">
        <collision name="floor_c"><pose>0 0 -0.06 0 0 0</pose><geometry><box><size>30 5 0.12</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 -0.06 0 0 0</pose><geometry><box><size>30 5 0.12</size></box></geometry><material><diffuse>0.42 0.44 0.48 1</diffuse></material></visual>
        <collision name="wall_n_c"><pose>0 2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>0 2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry><material><diffuse>0.64 0.68 0.73 1</diffuse></material></visual>
        <collision name="wall_s_c"><pose>0 -2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>0 -2.5 1.55 0 0 0</pose><geometry><box><size>30 0.16 3.10</size></box></geometry><material><diffuse>0.58 0.63 0.69 1</diffuse></material></visual>
        <collision name="end_w_c"><pose>-15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry></collision>
        <visual name="end_w_v"><pose>-15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry><material><diffuse>0.50 0.58 0.65 1</diffuse></material></visual>
        <collision name="end_e_c"><pose>15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry></collision>
        <visual name="end_e_v"><pose>15 0 1.55 0 0 0</pose><geometry><box><size>0.16 5 3.10</size></box></geometry><material><diffuse>0.63 0.53 0.42 1</diffuse></material></visual>

        <!-- Direct high-information viewpoint has insufficient AL.  The right
             local trajectory acquires richer geometry with a small detour. -->
        <collision name="integrity_panel_c"><pose>-8.25 0.86 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry></collision>
        <visual name="integrity_panel_v"><pose>-8.25 0.86 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry><material><diffuse>0.78 0.30 0.14 1</diffuse></material></visual>
        <collision name="south_fins_c"><pose>-8.25 -2.18 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry></collision>
        <visual name="south_fins_v"><pose>-8.25 -2.18 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry><material><diffuse>0.20 0.52 0.66 1</diffuse></material></visual>
        <collision name="pier_01_c"><pose>-2.0 2.12 1.0 0 0 0</pose><geometry><box><size>0.45 0.60 2.0</size></box></geometry></collision>
        <visual name="pier_01_v"><pose>-2.0 2.12 1.0 0 0 0</pose><geometry><box><size>0.45 0.60 2.0</size></box></geometry><material><diffuse>0.29 0.62 0.35 1</diffuse></material></visual>
        <collision name="pier_02_c"><pose>5.0 -2.12 0.8 0 0 0</pose><geometry><box><size>0.55 0.65 1.6</size></box></geometry></collision>
        <visual name="pier_02_v"><pose>5.0 -2.12 0.8 0 0 0</pose><geometry><box><size>0.55 0.65 1.6</size></box></geometry><material><diffuse>0.62 0.45 0.18 1</diffuse></material></visual>

        <!-- Downstream rolling-horizon integrity island.  It repeats the
             certified choice structure after the online map has advanced:
             the centerline is tight while the south/right viewpoint retains
             clearance and observes an extended feature surface. -->
        <collision name="integrity_panel_02_c"><pose>6.0 0.86 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry></collision>
        <visual name="integrity_panel_02_v"><pose>6.0 0.86 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry><material><diffuse>0.72 0.24 0.18 1</diffuse></material></visual>
        <collision name="south_fins_02_c"><pose>6.0 -2.18 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry></collision>
        <visual name="south_fins_02_v"><pose>6.0 -2.18 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry><material><diffuse>0.16 0.48 0.70 1</diffuse></material></visual>

        <!-- Wall-mounted transverse ribs add genuine x-normal constraints in
             the otherwise longitudinal corridor.  Their inner faces remain
             more than 1.45 m from every candidate centerline, so they improve
             observability without narrowing or obstructing the flight lane. -->
        <collision name="south_rib_01_c"><pose>-3.5 -2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry></collision>
        <visual name="south_rib_01_v"><pose>-3.5 -2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry><material><diffuse>0.22 0.58 0.72 1</diffuse></material></visual>
        <collision name="north_rib_02_c"><pose>0.0 2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry></collision>
        <visual name="north_rib_02_v"><pose>0.0 2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry><material><diffuse>0.70 0.52 0.18 1</diffuse></material></visual>
        <collision name="south_rib_03_c"><pose>3.5 -2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry></collision>
        <visual name="south_rib_03_v"><pose>3.5 -2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry><material><diffuse>0.22 0.58 0.72 1</diffuse></material></visual>
        <collision name="north_rib_04_c"><pose>8.5 2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry></collision>
        <visual name="north_rib_04_v"><pose>8.5 2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry><material><diffuse>0.70 0.52 0.18 1</diffuse></material></visual>
        <collision name="south_rib_05_c"><pose>11.5 -2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry></collision>
        <visual name="south_rib_05_v"><pose>11.5 -2.12 1.10 0 0 0</pose><geometry><box><size>0.32 0.60 2.20</size></box></geometry><material><diffuse>0.22 0.58 0.72 1</diffuse></material></visual>

        <!-- Low wall ledges stay below the vehicle and leave the open top
             unobstructed.  Their horizontal upper faces fall inside the
             Mid-360 vertical field of view and provide persistent z-normal
             constraints that the distant floor alone cannot supply. -->
        <collision name="north_observation_ledge_c"><pose>0 2.20 0.99 0 0 0</pose><geometry><box><size>30 0.45 0.12</size></box></geometry></collision>
        <visual name="north_observation_ledge_v"><pose>0 2.20 0.99 0 0 0</pose><geometry><box><size>30 0.45 0.12</size></box></geometry><material><diffuse>0.76 0.68 0.30 1</diffuse></material></visual>
        <collision name="south_observation_ledge_c"><pose>0 -2.20 0.99 0 0 0</pose><geometry><box><size>30 0.45 0.12</size></box></geometry></collision>
        <visual name="south_observation_ledge_v"><pose>0 -2.20 0.99 0 0 0</pose><geometry><box><size>30 0.45 0.12</size></box></geometry><material><diffuse>0.28 0.67 0.74 1</diffuse></material></visual>
      </link>
    </model>
    <include><name>xq_agent_01</name><uri>model://xq_iris_mid360</uri><pose>-12 0 1.2 0 0 0</pose></include>
  </world>
</sdf>
