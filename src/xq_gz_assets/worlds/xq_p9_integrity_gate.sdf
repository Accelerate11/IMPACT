<?xml version="1.0"?>
<sdf version="1.10">
  <world name="xq_p9_integrity_gate">
    <gravity>0 0 -9.80665</gravity>
    <physics name="xq_p9_1khz" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <scene>
      <ambient>0.78 0.80 0.84</ambient>
      <background>0.16 0.18 0.22</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- Open-top certification laboratory: walls stay visible; there is no roof. -->
    <model name="xq_p9_gate_geometry">
      <static>true</static>
      <link name="geometry">
        <collision name="floor_collision">
          <pose>0 0 -0.06 0 0 0</pose>
          <geometry><box><size>10 12 0.12</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.06 0 0 0</pose>
          <geometry><box><size>10 12 0.12</size></box></geometry>
          <material><ambient>0.34 0.37 0.41 1</ambient><diffuse>0.45 0.48 0.52 1</diffuse></material>
        </visual>

        <!-- wide_room: centre y=4, clear width 3.0 m -->
        <collision name="wide_south_collision"><pose>0 2.5 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry></collision>
        <collision name="wide_north_collision"><pose>0 5.5 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry></collision>
        <collision name="wide_west_collision"><pose>-4 4 1.2 0 0 0</pose><geometry><box><size>0.12 3.12 2.4</size></box></geometry></collision>
        <collision name="wide_east_collision"><pose>4 4 1.2 0 0 0</pose><geometry><box><size>0.12 3.12 2.4</size></box></geometry></collision>
        <visual name="wide_south_visual"><pose>0 2.5 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry><material><ambient>0.32 0.65 0.42 1</ambient><diffuse>0.40 0.82 0.52 1</diffuse></material></visual>
        <visual name="wide_north_visual"><pose>0 5.5 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry><material><ambient>0.32 0.65 0.42 1</ambient><diffuse>0.40 0.82 0.52 1</diffuse></material></visual>
        <visual name="wide_west_visual"><pose>-4 4 1.2 0 0 0</pose><geometry><box><size>0.12 3.12 2.4</size></box></geometry><material><ambient>0.32 0.65 0.42 1</ambient><diffuse>0.40 0.82 0.52 1</diffuse></material></visual>
        <visual name="wide_east_visual"><pose>4 4 1.2 0 0 0</pose><geometry><box><size>0.12 3.12 2.4</size></box></geometry><material><ambient>0.32 0.65 0.42 1</ambient><diffuse>0.40 0.82 0.52 1</diffuse></material></visual>

        <!-- narrow_passage: centre y=-4, clear width 1.2 m -->
        <collision name="narrow_south_collision"><pose>0 -4.6 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry></collision>
        <collision name="narrow_north_collision"><pose>0 -3.4 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry></collision>
        <collision name="narrow_west_collision"><pose>-4 -4 1.2 0 0 0</pose><geometry><box><size>0.12 1.32 2.4</size></box></geometry></collision>
        <collision name="narrow_east_collision"><pose>4 -4 1.2 0 0 0</pose><geometry><box><size>0.12 1.32 2.4</size></box></geometry></collision>
        <visual name="narrow_south_visual"><pose>0 -4.6 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry><material><ambient>0.72 0.28 0.25 1</ambient><diffuse>0.90 0.34 0.30 1</diffuse></material></visual>
        <visual name="narrow_north_visual"><pose>0 -3.4 1.2 0 0 0</pose><geometry><box><size>8 0.12 2.4</size></box></geometry><material><ambient>0.72 0.28 0.25 1</ambient><diffuse>0.90 0.34 0.30 1</diffuse></material></visual>
        <visual name="narrow_west_visual"><pose>-4 -4 1.2 0 0 0</pose><geometry><box><size>0.12 1.32 2.4</size></box></geometry><material><ambient>0.72 0.28 0.25 1</ambient><diffuse>0.90 0.34 0.30 1</diffuse></material></visual>
        <visual name="narrow_east_visual"><pose>4 -4 1.2 0 0 0</pose><geometry><box><size>0.12 1.32 2.4</size></box></geometry><material><ambient>0.72 0.28 0.25 1</ambient><diffuse>0.90 0.34 0.30 1</diffuse></material></visual>

        <visual name="wide_accept_track"><pose>0 4 0.03 0 0 0</pose><geometry><box><size>5 0.10 0.05</size></box></geometry><material><ambient>0.05 0.85 0.22 1</ambient><diffuse>0.05 1 0.28 1</diffuse><emissive>0.02 0.35 0.08 1</emissive></material></visual>
        <visual name="narrow_reject_track"><pose>0 -4 0.03 0 0 0</pose><geometry><box><size>5 0.10 0.05</size></box></geometry><material><ambient>0.95 0.08 0.06 1</ambient><diffuse>1 0.10 0.08 1</diffuse><emissive>0.35 0.02 0.01 1</emissive></material></visual>
      </link>
    </model>

    <model name="wide_room_candidate_uav">
      <static>true</static><pose>-2.5 4 1.2 0 0 0</pose><link name="body">
        <visual name="body_visual"><geometry><sphere><radius>0.25</radius></sphere></geometry><material><ambient>0.05 0.85 0.22 1</ambient><diffuse>0.05 1 0.28 1</diffuse></material></visual>
      </link>
    </model>
    <model name="narrow_passage_candidate_uav">
      <static>true</static><pose>-2.5 -4 1.2 0 0 0</pose><link name="body">
        <visual name="body_visual"><geometry><sphere><radius>0.25</radius></sphere></geometry><material><ambient>0.95 0.08 0.06 1</ambient><diffuse>1 0.10 0.08 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
