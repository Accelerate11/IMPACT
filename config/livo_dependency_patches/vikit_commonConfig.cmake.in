@PACKAGE_INIT@
set(_impact_vikit_common_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.3)
find_dependency(OpenCV)
find_dependency(Sophus 1.22.10 EXACT CONFIG)
find_dependency(fmt)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/vikitCommonTargets.cmake")
set(vikit_common_INCLUDE_DIRS "${_impact_vikit_common_prefix}/include")
set(vikit_common_INCLUDE_DIR "${vikit_common_INCLUDE_DIRS}")
set(vikit_common_LIBRARIES vikit_common::vikit_common)
set(vikit_common_LIBRARY vikit_common::vikit_common)
