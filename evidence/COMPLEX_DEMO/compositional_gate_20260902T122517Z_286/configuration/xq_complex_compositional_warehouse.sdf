        <collision name="landing_pad_c"><pose>14.0 -6.7 0.06 0 0 0</pose><geometry><cylinder><radius>1.2</radius><length>0.12</length></cylinder></geometry></collision>
        <visual name="landing_pad_v"><pose>14.0 -6.7 0.06 0 0 0</pose><geometry><cylinder><radius>1.2</radius><length>0.12</length></cylinder></geometry><material><diffuse>0.12 0.70 0.30 1</diffuse><emissive>0.02 0.18 0.06 1</emissive></material></visual>
      </link>
    </model>

    <model name="xq_p12_moving_obstacle">
      <static>false</static><pose>-4.5 6.6 1.0 0 0 0</pose>
      <link name="body"><gravity>false</gravity><inertial><mass>20</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>4</izz></inertia></inertial>
        <collision name="body_c"><geometry><box><size>0.9 0.9 2.0</size></box></geometry></collision>
