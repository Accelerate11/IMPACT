        <collision name="ne_partition_c"><pose>7.5 5.25 1.5 0 0 0</pose><geometry><box><size>0.18 5.3 3.0</size></box></geometry></collision>
        <visual name="ne_partition_v"><pose>7.5 5.25 1.5 0 0 0</pose><geometry><box><size>0.18 5.3 3.0</size></box></geometry><material><diffuse>0.70 0.42 0.24 1</diffuse></material></visual>
        <collision name="se_partition_c"><pose>7.5 -5.25 1.5 0 0 0</pose><geometry><box><size>0.18 5.3 3.0</size></box></geometry></collision>
        <visual name="se_partition_v"><pose>7.5 -5.25 1.5 0 0 0</pose><geometry><box><size>0.18 5.3 3.0</size></box></geometry><material><diffuse>0.69 0.52 0.23 1</diffuse></material></visual>
        <collision name="north_crosswall_c"><pose>-0.25 5.8 1.45 0 0 0</pose><geometry><box><size>15.3 0.16 2.9</size></box></geometry></collision>
        <visual name="north_crosswall_v"><pose>-0.25 5.8 1.45 0 0 0</pose><geometry><box><size>15.3 0.16 2.9</size></box></geometry><material><diffuse>0.58 0.35 0.56 1</diffuse></material></visual>
        <collision name="south_crosswall_c"><pose>-0.25 -5.8 1.45 0 0 0</pose><geometry><box><size>15.3 0.16 2.9</size></box></geometry></collision>
        <visual name="south_crosswall_v"><pose>-0.25 -5.8 1.45 0 0 0</pose><geometry><box><size>15.3 0.16 2.9</size></box></geometry><material><diffuse>0.34 0.55 0.43 1</diffuse></material></visual>

        <!-- Continuous six-level observation racks address the measured
             vertical weak mode (terminal weak direction z=0.9999).  Their
             horizontal faces provide genuine Mid-360 z-normal constraints,
             while their inner edges remain more than 1.50 m outside the
             certified candidate centreline.  The 4.80 m-wide overhead opening remains
             completely roofless for the requested Gazebo top view. -->
        <collision name="north_lower_observation_rack_c"><pose>0 2.90 0.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="north_lower_observation_rack_v"><pose>0 2.90 0.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.82 0.58 0.14 1</diffuse></material></visual>
        <collision name="south_lower_observation_rack_c"><pose>0 -2.90 0.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="south_lower_observation_rack_v"><pose>0 -2.90 0.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.12 0.66 0.78 1</diffuse></material></visual>
        <collision name="north_lower_middle_observation_rack_c"><pose>0 2.90 1.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="north_lower_middle_observation_rack_v"><pose>0 2.90 1.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.85 0.62 0.16 1</diffuse></material></visual>
        <collision name="south_lower_middle_observation_rack_c"><pose>0 -2.90 1.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="south_lower_middle_observation_rack_v"><pose>0 -2.90 1.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.14 0.69 0.80 1</diffuse></material></visual>
        <collision name="north_middle_observation_rack_c"><pose>0 2.90 1.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="north_middle_observation_rack_v"><pose>0 2.90 1.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.88 0.65 0.18 1</diffuse></material></visual>
        <collision name="south_middle_observation_rack_c"><pose>0 -2.90 1.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="south_middle_observation_rack_v"><pose>0 -2.90 1.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.15 0.72 0.82 1</diffuse></material></visual>
        <collision name="north_upper_middle_observation_rack_c"><pose>0 2.90 2.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="north_upper_middle_observation_rack_v"><pose>0 2.90 2.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.90 0.68 0.19 1</diffuse></material></visual>
        <collision name="south_upper_middle_observation_rack_c"><pose>0 -2.90 2.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="south_upper_middle_observation_rack_v"><pose>0 -2.90 2.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.17 0.74 0.83 1</diffuse></material></visual>
        <collision name="north_upper_observation_rack_c"><pose>0 2.90 2.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="north_upper_observation_rack_v"><pose>0 2.90 2.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.92 0.72 0.20 1</diffuse></material></visual>
        <collision name="south_upper_observation_rack_c"><pose>0 -2.90 2.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="south_upper_observation_rack_v"><pose>0 -2.90 2.55 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.18 0.76 0.84 1</diffuse></material></visual>
        <collision name="north_high_observation_rack_c"><pose>0 2.90 3.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="north_high_observation_rack_v"><pose>0 2.90 3.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.94 0.75 0.22 1</diffuse></material></visual>
        <collision name="south_high_observation_rack_c"><pose>0 -2.90 3.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry></collision>
        <visual name="south_high_observation_rack_v"><pose>0 -2.90 3.05 0 0 0</pose><geometry><box><size>29.0 1.00 0.12</size></box></geometry><material><diffuse>0.20 0.79 0.87 1</diffuse></material></visual>

        <!-- Local low observation shelves: their upward faces supply real
             Mid-360 z-normal information before the eastern portal section.
             They end at x=3, behind the lane-change start, so the open roof
             and every certified forward/side flight corridor remain clear. -->
        <collision name="north_observation_shelf_c"><pose>1.0 2.60 0.99 0 0 0</pose><geometry><box><size>4.0 0.45 0.12</size></box></geometry></collision>
        <visual name="north_observation_shelf_v"><pose>1.0 2.60 0.99 0 0 0</pose><geometry><box><size>4.0 0.45 0.12</size></box></geometry><material><diffuse>0.82 0.72 0.22 1</diffuse></material></visual>
        <collision name="south_observation_shelf_c"><pose>1.0 -2.60 0.99 0 0 0</pose><geometry><box><size>4.0 0.45 0.12</size></box></geometry></collision>
        <visual name="south_observation_shelf_v"><pose>1.0 -2.60 0.99 0 0 0</pose><geometry><box><size>4.0 0.45 0.12</size></box></geometry><material><diffuse>0.24 0.72 0.78 1</diffuse></material></visual>

        <!-- Fill the measured second-horizon observability gap from
             x=-4.5..-1.0 m.  These low ledges stay outside the certified
             displaced candidate centreline while supplying z-normal
             information throughout the otherwise open mid-west aisle. -->
        <collision name="north_midwest_observation_shelf_c"><pose>-2.75 2.60 0.99 0 0 0</pose><geometry><box><size>3.50 0.45 0.12</size></box></geometry></collision>
        <visual name="north_midwest_observation_shelf_v"><pose>-2.75 2.60 0.99 0 0 0</pose><geometry><box><size>3.50 0.45 0.12</size></box></geometry><material><diffuse>0.84 0.70 0.18 1</diffuse></material></visual>
        <collision name="south_midwest_observation_shelf_c"><pose>-2.75 -2.60 0.99 0 0 0</pose><geometry><box><size>3.50 0.45 0.12</size></box></geometry></collision>
        <visual name="south_midwest_observation_shelf_v"><pose>-2.75 -2.60 0.99 0 0 0</pose><geometry><box><size>3.50 0.45 0.12</size></box></geometry><material><diffuse>0.18 0.72 0.78 1</diffuse></material></visual>

        <!-- East x-normal barcode array closes the measured longitudinal
             observability gap without adding another long corridor surface.
             Each thin, tall plate faces the flight direction: its dominant
             LiDAR plane normal is x, complementing the floor's z normal and
             the existing side geometry's y normal.  All plates remain at
             least 1.00 m outside the +/-0.70 m candidate centreline. -->
        <collision name="north_x_board1_c"><pose>3.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="north_x_board1_v"><pose>3.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.10 0.72 0.96 1</diffuse><emissive>0.01 0.08 0.14 1</emissive></material></visual>
        <collision name="south_x_board0_c"><pose>2.45 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="south_x_board0_v"><pose>2.45 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.20 0.84 0.62 1</diffuse><emissive>0.01 0.12 0.07 1</emissive></material></visual>
        <collision name="south_x_board1_c"><pose>4.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="south_x_board1_v"><pose>4.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.96 0.56 0.10 1</diffuse><emissive>0.14 0.05 0.01 1</emissive></material></visual>
        <collision name="north_x_board2_c"><pose>5.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="north_x_board2_v"><pose>5.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.20 0.84 0.62 1</diffuse><emissive>0.01 0.12 0.07 1</emissive></material></visual>
        <collision name="south_x_board2_c"><pose>6.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="south_x_board2_v"><pose>6.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.80 0.28 0.24 1</diffuse><emissive>0.10 0.02 0.02 1</emissive></material></visual>
        <collision name="north_x_board3_c"><pose>7.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="north_x_board3_v"><pose>7.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.94 0.72 0.12 1</diffuse><emissive>0.12 0.08 0.01 1</emissive></material></visual>
        <collision name="south_x_board3_c"><pose>8.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="south_x_board3_v"><pose>8.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.10 0.72 0.96 1</diffuse><emissive>0.01 0.08 0.14 1</emissive></material></visual>
        <collision name="north_x_board4_c"><pose>9.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="north_x_board4_v"><pose>9.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.96 0.56 0.10 1</diffuse><emissive>0.14 0.05 0.01 1</emissive></material></visual>
        <collision name="south_x_board4_c"><pose>10.95 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="south_x_board4_v"><pose>10.95 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.20 0.84 0.62 1</diffuse><emissive>0.01 0.12 0.07 1</emissive></material></visual>
        <collision name="north_x_board5_c"><pose>11.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="north_x_board5_v"><pose>11.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.80 0.28 0.24 1</diffuse><emissive>0.10 0.02 0.02 1</emissive></material></visual>
        <collision name="south_x_board5_c"><pose>12.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="south_x_board5_v"><pose>12.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.94 0.72 0.12 1</diffuse><emissive>0.12 0.08 0.01 1</emissive></material></visual>
        <collision name="north_x_board6_c"><pose>13.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
        <visual name="north_x_board6_v"><pose>13.55 2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry><material><diffuse>0.10 0.72 0.96 1</diffuse><emissive>0.01 0.08 0.14 1</emissive></material></visual>
        <collision name="south_x_board6_c"><pose>14.35 -2.25 1.25 0 0 0</pose><geometry><box><size>0.12 1.10 2.50</size></box></geometry></collision>
