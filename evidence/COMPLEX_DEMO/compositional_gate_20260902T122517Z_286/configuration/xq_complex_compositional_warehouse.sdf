        <enter_start_s>24.0</enter_start_s><enter_end_s>28.0</enter_end_s><leave_start_s>44.0</leave_start_s><leave_end_s>48.0</leave_end_s>
      </plugin>
    </model>

    <!-- A second overhead mover adds non-blocking 3D dynamics in the second
         horizon.  It is deliberately upstream of the spatial integrity deck
         so it cannot preclude the third-horizon UP candidate. -->
    <model name="xq_overhead_inspector">
      <static>false</static><pose>0.8 6.2 2.65 0 0 0</pose>
      <link name="body"><gravity>false</gravity><inertial><mass>8</mass><inertia><ixx>2</ixx><iyy>2</iyy><izz>2</izz></inertia></inertial>
        <collision name="body_c"><geometry><sphere><radius>0.32</radius></sphere></geometry></collision>
        <visual name="body_v"><geometry><sphere><radius>0.32</radius></sphere></geometry><material><diffuse>0.10 0.78 0.95 1</diffuse><emissive>0.02 0.35 0.50 1</emissive></material></visual>
      </link>
      <plugin filename="libxq_p12_obstacle_motion_system.so" name="xq_gz_bridge::P12ObstacleMotionSystem">
        <x_m>0.8</x_m><park_y_m>6.2</park_y_m><blocked_y_m>0.0</blocked_y_m><z_m>2.65</z_m>
        <enter_start_s>55.0</enter_start_s><enter_end_s>61.0</enter_end_s><leave_start_s>72.0</leave_start_s><leave_end_s>78.0</leave_end_s>
      </plugin>
    </model>

