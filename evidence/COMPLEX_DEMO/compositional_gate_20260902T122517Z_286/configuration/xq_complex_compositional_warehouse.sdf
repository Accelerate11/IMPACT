<?xml version="1.0"?>
<sdf version="1.10">
  <world name="xq_complex_compositional_warehouse">
    <gravity>0 0 -9.80665</gravity>
    <physics name="xq_complex_400hz_physics" type="ode">
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>400</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene>
      <ambient>0.62 0.66 0.72</ambient>
      <background>0.10 0.12 0.16</background>
      <shadows>true</shadows>
    </scene>
    <light name="complex_sun" type="directional">
      <pose>0 0 12 0 0 0</pose><diffuse>0.78 0.82 0.90 1</diffuse>
      <specular>0.25 0.25 0.28 1</specular><direction>-0.35 0.25 -1</direction>
    </light>
    <light name="west_high_bay" type="point">
      <pose>-9 0 5 0 0 0</pose><diffuse>0.75 0.86 1 1</diffuse><attenuation><range>15</range><constant>0.4</constant><linear>0.04</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="east_high_bay" type="point">
      <pose>9 0 5 0 0 0</pose><diffuse>1 0.84 0.63 1</diffuse><attenuation><range>15</range><constant>0.4</constant><linear>0.04</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- Independent compositional 3D challenge scene. Roof intentionally
         omitted; perimeter walls retained. -->
    <model name="xq_complex_compositional_shell">
      <static>true</static>
      <link name="shell">
        <collision name="floor_c"><pose>0 0 -0.08 0 0 0</pose><geometry><box><size>34 16 0.16</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 -0.08 0 0 0</pose><geometry><box><size>34 16 0.16</size></box></geometry><material><diffuse>0.32 0.35 0.40 1</diffuse><specular>0.12 0.12 0.12 1</specular></material></visual>
        <collision name="north_wall_c"><pose>0 8 1.8 0 0 0</pose><geometry><box><size>34 0.20 3.6</size></box></geometry></collision>
        <visual name="north_wall_v"><pose>0 8 1.8 0 0 0</pose><geometry><box><size>34 0.20 3.6</size></box></geometry><material><diffuse>0.53 0.59 0.68 1</diffuse></material></visual>
        <collision name="south_wall_c"><pose>0 -8 1.8 0 0 0</pose><geometry><box><size>34 0.20 3.6</size></box></geometry></collision>
        <visual name="south_wall_v"><pose>0 -8 1.8 0 0 0</pose><geometry><box><size>34 0.20 3.6</size></box></geometry><material><diffuse>0.49 0.56 0.65 1</diffuse></material></visual>
        <collision name="west_wall_c"><pose>-17 0 1.8 0 0 0</pose><geometry><box><size>0.20 16 3.6</size></box></geometry></collision>
        <visual name="west_wall_v"><pose>-17 0 1.8 0 0 0</pose><geometry><box><size>0.20 16 3.6</size></box></geometry><material><diffuse>0.41 0.50 0.61 1</diffuse></material></visual>
        <collision name="east_wall_c"><pose>17 0 1.8 0 0 0</pose><geometry><box><size>0.20 16 3.6</size></box></geometry></collision>
        <visual name="east_wall_v"><pose>17 0 1.8 0 0 0</pose><geometry><box><size>0.20 16 3.6</size></box></geometry><material><diffuse>0.65 0.48 0.36 1</diffuse></material></visual>

        <!-- Four side rooms with 3.2 m-wide open central aisle. -->
        <collision name="nw_partition_c"><pose>-8.0 5.25 1.5 0 0 0</pose><geometry><box><size>0.18 5.3 3.0</size></box></geometry></collision>
        <visual name="nw_partition_v"><pose>-8.0 5.25 1.5 0 0 0</pose><geometry><box><size>0.18 5.3 3.0</size></box></geometry><material><diffuse>0.27 0.50 0.70 1</diffuse></material></visual>
        <collision name="sw_partition_c"><pose>-8.0 -5.25 1.5 0 0 0</pose><geometry><box><size>0.18 5.3 3.0</size></box></geometry></collision>
