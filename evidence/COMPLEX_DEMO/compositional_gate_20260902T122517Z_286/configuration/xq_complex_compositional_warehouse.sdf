        <!-- Final-approach two-level observation gallery supplies genuine
             near-field z-normal constraints to the Mid-360 scan.  The centre
             remains 3.05 m wide and roofless; the direct terminal trajectory
             has more than 1.5 m lateral clearance to either shelf. -->
        <collision name="north_final_observation_shelf_c"><pose>12.0 1.75 0.99 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry></collision>
        <visual name="north_final_observation_shelf_v"><pose>12.0 1.75 0.99 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry><material><diffuse>0.88 0.72 0.18 1</diffuse></material></visual>
        <collision name="south_final_observation_shelf_c"><pose>12.0 -1.75 0.99 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry></collision>
        <visual name="south_final_observation_shelf_v"><pose>12.0 -1.75 0.99 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry><material><diffuse>0.16 0.76 0.80 1</diffuse></material></visual>
        <collision name="north_final_upper_observation_shelf_c"><pose>12.0 1.75 1.90 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry></collision>
        <visual name="north_final_upper_observation_shelf_v"><pose>12.0 1.75 1.90 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry><material><diffuse>0.95 0.52 0.12 1</diffuse></material></visual>
        <collision name="south_final_upper_observation_shelf_c"><pose>12.0 -1.75 1.90 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry></collision>
        <visual name="south_final_upper_observation_shelf_v"><pose>12.0 -1.75 1.90 0 0 0</pose><geometry><box><size>5.0 0.45 0.12</size></box></geometry><material><diffuse>0.10 0.72 0.92 1</diffuse></material></visual>

        <!-- Two mirrored integrity challenge islands make the planner prove
             that its avoidance sign is data-driven.  The west panel blocks
             integrity to the north and requires a south/right observation
             arc; the east panel is mirrored and requires a north/left arc.
             Both leave the physical centreline flyable but below the frozen
             integrity reserve.  The 0.70 m arcs return to the centreline only
             after clearing each panel's protected trailing corner. -->
        <collision name="integrity_panel_west_c"><pose>-8.25 0.81 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry></collision>
        <visual name="integrity_panel_west_v"><pose>-8.25 0.81 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry><material><diffuse>0.96 0.22 0.10 1</diffuse><emissive>0.16 0.02 0.01 1</emissive></material></visual>
        <collision name="geometry_fins_west_c"><pose>-8.25 -2.43 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry></collision>
        <visual name="geometry_fins_west_v"><pose>-8.25 -2.43 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry><material><diffuse>0.08 0.62 0.92 1</diffuse><emissive>0.01 0.08 0.16 1</emissive></material></visual>
        <collision name="integrity_panel_east_c"><pose>-1.0 -0.81 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry></collision>
        <visual name="integrity_panel_east_v"><pose>-1.0 -0.81 1.20 0 0 0</pose><geometry><box><size>2.50 0.12 2.20</size></box></geometry><material><diffuse>0.96 0.22 0.10 1</diffuse><emissive>0.16 0.02 0.01 1</emissive></material></visual>
        <collision name="geometry_fins_east_c"><pose>-1.0 2.43 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry></collision>
        <visual name="geometry_fins_east_v"><pose>-1.0 2.43 1.10 0 0 0</pose><geometry><box><size>2.80 0.45 2.20</size></box></geometry><material><diffuse>0.08 0.62 0.92 1</diffuse><emissive>0.01 0.08 0.16 1</emissive></material></visual>

        <!-- Visual-only floor bands identify the two integrity decisions and
             the dynamic-obstacle crossing from the open-roof Gazebo view. -->
        <visual name="west_integrity_zone_v"><pose>-8.25 0 0.015 0 0 0</pose><geometry><box><size>2.8 3.0 0.018</size></box></geometry><material><diffuse>0.60 0.16 0.08 0.44</diffuse><emissive>0.07 0.01 0.00 1</emissive></material></visual>
        <visual name="dynamic_crossing_zone_v"><pose>-4.5 0 0.016 0 0 0</pose><geometry><box><size>1.3 3.0 0.020</size></box></geometry><material><diffuse>0.86 0.56 0.04 0.48</diffuse><emissive>0.10 0.05 0.00 1</emissive></material></visual>
        <visual name="east_integrity_zone_v"><pose>-1.0 0 0.015 0 0 0</pose><geometry><box><size>2.8 3.0 0.018</size></box></geometry><material><diffuse>0.10 0.24 0.66 0.44</diffuse><emissive>0.01 0.03 0.10 1</emissive></material></visual>

        <!-- Third rolling horizon: a low, wide integrity hurdle keeps the
             centre, left and right paths physically flyable with about
             0.10 m body clearance, but below the frozen positioning-
             integrity reserve.  Its vertical face is visible in the real
             Mid-360 field of view before the rolling decision.  The optional
             spatial candidate climbs 0.70 m, holds above the whole hurdle
             and returns to cruise height before the horizon boundary.  This
             is ordinary obstacle-rich autonomy, not fault injection. -->
        <collision name="spatial_integrity_hurdle_c"><pose>8.00 0 0.375 0 0 0</pose><geometry><box><size>0.18 4.00 0.75</size></box></geometry></collision>
        <visual name="spatial_integrity_hurdle_v"><pose>8.00 0 0.375 0 0 0</pose><geometry><box><size>0.18 4.00 0.75</size></box></geometry><material><diffuse>0.58 0.12 0.92 1</diffuse><emissive>0.12 0.01 0.24 1</emissive></material></visual>

        <!-- Elevated north panel composes with the low hurdle.  The hurdle
             rejects direct/right/left at cruise height.  At elevated height
             this panel rejects pure UP and UP+LEFT, while UP+RIGHT keeps more
             than 1.2 m lateral centreline clearance.  Candidate generation
             is generic and the selection still comes from the same AL-PL
             hard constraint; no segment-index rule exists. -->
        <collision name="elevated_north_integrity_panel_c"><pose>8.00 0.56 1.90 0 0 0</pose><geometry><box><size>2.50 0.12 1.20</size></box></geometry></collision>
        <visual name="elevated_north_integrity_panel_v"><pose>8.00 0.56 1.90 0 0 0</pose><geometry><box><size>2.50 0.12 1.20</size></box></geometry><material><diffuse>0.96 0.18 0.48 1</diffuse><emissive>0.20 0.01 0.08 1</emissive></material></visual>
        <collision name="spatial_deck_north_leg_c"><pose>8.00 2.15 0.65 0 0 0</pose><geometry><box><size>0.24 0.24 1.30</size></box></geometry></collision>
        <visual name="spatial_deck_north_leg_v"><pose>8.00 2.15 0.65 0 0 0</pose><geometry><box><size>0.24 0.24 1.30</size></box></geometry><material><diffuse>0.40 0.08 0.70 1</diffuse></material></visual>
        <collision name="spatial_deck_south_leg_c"><pose>8.00 -2.15 0.65 0 0 0</pose><geometry><box><size>0.24 0.24 1.30</size></box></geometry></collision>
        <visual name="spatial_deck_south_leg_v"><pose>8.00 -2.15 0.65 0 0 0</pose><geometry><box><size>0.24 0.24 1.30</size></box></geometry><material><diffuse>0.40 0.08 0.70 1</diffuse></material></visual>
        <visual name="spatial_integrity_zone_v"><pose>8.00 0 0.017 0 0 0</pose><geometry><box><size>3.00 4.40 0.022</size></box></geometry><material><diffuse>0.50 0.08 0.82 0.48</diffuse><emissive>0.08 0.00 0.15 1</emissive></material></visual>

        <!-- Alternating shelves and work cells. -->
        <collision name="rack_nw_c"><pose>-12.0 4.2 1.15 0 0 0</pose><geometry><box><size>5.8 0.75 2.3</size></box></geometry></collision>
        <visual name="rack_nw_v"><pose>-12.0 4.2 1.15 0 0 0</pose><geometry><box><size>5.8 0.75 2.3</size></box></geometry><material><diffuse>0.18 0.44 0.68 1</diffuse></material></visual>
        <collision name="rack_sw_c"><pose>-3.8 -4.25 1.15 0 0 0</pose><geometry><box><size>5.0 0.75 2.3</size></box></geometry></collision>
        <visual name="rack_sw_v"><pose>-3.8 -4.25 1.15 0 0 0</pose><geometry><box><size>5.0 0.75 2.3</size></box></geometry><material><diffuse>0.18 0.59 0.54 1</diffuse></material></visual>
        <collision name="rack_ne_c"><pose>2.0 4.25 1.15 0 0 0</pose><geometry><box><size>5.0 0.75 2.3</size></box></geometry></collision>
        <visual name="rack_ne_v"><pose>2.0 4.25 1.15 0 0 0</pose><geometry><box><size>5.0 0.75 2.3</size></box></geometry><material><diffuse>0.70 0.37 0.22 1</diffuse></material></visual>
        <collision name="rack_se_c"><pose>11.2 -4.2 1.15 0 0 0</pose><geometry><box><size>6.2 0.75 2.3</size></box></geometry></collision>
        <visual name="rack_se_v"><pose>11.2 -4.2 1.15 0 0 0</pose><geometry><box><size>6.2 0.75 2.3</size></box></geometry><material><diffuse>0.72 0.53 0.18 1</diffuse></material></visual>

        <!-- Pillar array creates strong but nonuniform LiDAR observability. -->
        <collision name="p1_c"><pose>-11.0 2.25 1.2 0 0 0</pose><geometry><box><size>0.45 0.45 2.4</size></box></geometry></collision>
        <visual name="p1_v"><pose>-11.0 2.25 1.2 0 0 0</pose><geometry><box><size>0.45 0.45 2.4</size></box></geometry><material><diffuse>0.90 0.30 0.20 1</diffuse></material></visual>
        <collision name="p2_c"><pose>-6.2 -2.50 1.2 0 0 0</pose><geometry><box><size>0.50 0.50 2.4</size></box></geometry></collision>
        <visual name="p2_v"><pose>-6.2 -2.50 1.2 0 0 0</pose><geometry><box><size>0.50 0.50 2.4</size></box></geometry><material><diffuse>0.22 0.72 0.86 1</diffuse></material></visual>
        <collision name="p3_c"><pose>-1.5 2.50 1.2 0 0 0</pose><geometry><box><size>0.45 0.45 2.4</size></box></geometry></collision>
        <visual name="p3_v"><pose>-1.5 2.50 1.2 0 0 0</pose><geometry><box><size>0.45 0.45 2.4</size></box></geometry><material><diffuse>0.88 0.68 0.16 1</diffuse></material></visual>
        <collision name="p4_c"><pose>3.4 -2.25 1.2 0 0 0</pose><geometry><box><size>0.50 0.50 2.4</size></box></geometry></collision>
        <visual name="p4_v"><pose>3.4 -2.25 1.2 0 0 0</pose><geometry><box><size>0.50 0.50 2.4</size></box></geometry><material><diffuse>0.84 0.28 0.23 1</diffuse></material></visual>
        <collision name="p5_c"><pose>8.2 2.25 1.2 0 0 0</pose><geometry><box><size>0.45 0.45 2.4</size></box></geometry></collision>
        <visual name="p5_v"><pose>8.2 2.25 1.2 0 0 0</pose><geometry><box><size>0.45 0.45 2.4</size></box></geometry><material><diffuse>0.25 0.75 0.43 1</diffuse></material></visual>
        <collision name="p6_c"><pose>12.6 -2.25 1.2 0 0 0</pose><geometry><box><size>0.50 0.50 2.4</size></box></geometry></collision>
        <visual name="p6_v"><pose>12.6 -2.25 1.2 0 0 0</pose><geometry><box><size>0.50 0.50 2.4</size></box></geometry><material><diffuse>0.31 0.56 0.85 1</diffuse></material></visual>

        <!-- Three portal frames preserve a flyable opening while adding vertical structure. -->
        <collision name="gate1_n_c"><pose>-9.0 2.35 1.4 0 0 0</pose><geometry><box><size>0.35 0.35 2.8</size></box></geometry></collision>
        <visual name="gate1_n_v"><pose>-9.0 2.35 1.4 0 0 0</pose><geometry><box><size>0.35 0.35 2.8</size></box></geometry><material><diffuse>0.75 0.20 0.18 1</diffuse></material></visual>
        <collision name="gate1_s_c"><pose>-9.0 -2.35 1.4 0 0 0</pose><geometry><box><size>0.35 0.35 2.8</size></box></geometry></collision>
        <visual name="gate1_s_v"><pose>-9.0 -2.35 1.4 0 0 0</pose><geometry><box><size>0.35 0.35 2.8</size></box></geometry><material><diffuse>0.75 0.20 0.18 1</diffuse></material></visual>
        <collision name="gate1_top_c"><pose>-9.0 0 2.75 0 0 0</pose><geometry><box><size>0.35 5.05 0.25</size></box></geometry></collision>
        <visual name="gate1_top_v"><pose>-9.0 0 2.75 0 0 0</pose><geometry><box><size>0.35 5.05 0.25</size></box></geometry><material><diffuse>0.92 0.40 0.16 1</diffuse></material></visual>
        <collision name="gate2_n_c"><pose>2.0 2.35 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry></collision>
        <visual name="gate2_n_v"><pose>2.0 2.35 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry><material><diffuse>0.20 0.64 0.78 1</diffuse></material></visual>
        <collision name="gate2_s_c"><pose>2.0 -2.35 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry></collision>
        <visual name="gate2_s_v"><pose>2.0 -2.35 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry><material><diffuse>0.20 0.64 0.78 1</diffuse></material></visual>
        <collision name="gate2_top_c"><pose>2.0 0 3.45 0 0 0</pose><geometry><box><size>0.35 5.05 0.25</size></box></geometry></collision>
        <visual name="gate2_top_v"><pose>2.0 0 3.45 0 0 0</pose><geometry><box><size>0.35 5.05 0.25</size></box></geometry><material><diffuse>0.16 0.78 0.70 1</diffuse></material></visual>
        <collision name="gate3_n_c"><pose>10.5 2.10 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry></collision>
        <visual name="gate3_n_v"><pose>10.5 2.10 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry><material><diffuse>0.78 0.62 0.18 1</diffuse></material></visual>
        <collision name="gate3_s_c"><pose>10.5 -2.10 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry></collision>
        <visual name="gate3_s_v"><pose>10.5 -2.10 1.8 0 0 0</pose><geometry><box><size>0.35 0.35 3.6</size></box></geometry><material><diffuse>0.78 0.62 0.18 1</diffuse></material></visual>
        <collision name="gate3_top_c"><pose>10.5 0 3.45 0 0 0</pose><geometry><box><size>0.35 4.55 0.25</size></box></geometry></collision>
        <visual name="gate3_top_v"><pose>10.5 0 3.45 0 0 0</pose><geometry><box><size>0.35 4.55 0.25</size></box></geometry><material><diffuse>0.95 0.50 0.15 1</diffuse></material></visual>

        <!-- Low clutter remains outside the certified central tube. -->
        <collision name="crate1_c"><pose>-13.5 -3.0 0.45 0 0 0.18</pose><geometry><box><size>1.2 1.0 0.9</size></box></geometry></collision>
        <visual name="crate1_v"><pose>-13.5 -3.0 0.45 0 0 0.18</pose><geometry><box><size>1.2 1.0 0.9</size></box></geometry><material><diffuse>0.58 0.34 0.16 1</diffuse></material></visual>
        <collision name="crate2_c"><pose>-2.0 3.0 0.35 0 0 -0.22</pose><geometry><box><size>1.4 0.9 0.7</size></box></geometry></collision>
