        <collision name="barrel1_c"><pose>13.5 3.0 0.55 0 0 0</pose><geometry><cylinder><radius>0.48</radius><length>1.1</length></cylinder></geometry></collision>
        <visual name="barrel1_v"><pose>13.5 3.0 0.55 0 0 0</pose><geometry><cylinder><radius>0.48</radius><length>1.1</length></cylinder></geometry><material><diffuse>0.15 0.44 0.74 1</diffuse></material></visual>
        <collision name="barrel2_c"><pose>14.3 4.0 0.55 0 0 0</pose><geometry><cylinder><radius>0.48</radius><length>1.1</length></cylinder></geometry></collision>
